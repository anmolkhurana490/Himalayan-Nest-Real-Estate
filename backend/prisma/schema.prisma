// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  dealer
  customer
}

enum AuthProvider {
  credentials
  google
  facebook
}

model User {
  id    String  @id @default(cuid())
  name  String
  email String  @unique
  phone String?
  role  String
  bio   String?

  provider          AuthProvider @default(credentials)
  password          String? // Only for credentials provider
  providerAccountId String? // Only for OAuth

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties        Property[]
  enquiryMessages   EnquiryMessage[]
  sentEnquiries     Enquiry[]        @relation("SentEnquiries")
  receivedEnquiries Enquiry[]        @relation("ReceivedEnquiries")
}

enum PropertyCategory {
  residential
  commercial
  land
  industrial
}

enum PropertyPurpose {
  sale
  rent
}

model Property {
  id               String           @id @default(cuid())
  title            String
  description      String
  purpose          PropertyPurpose
  category         PropertyCategory
  property_subtype String
  price            Float
  location         String

  authorId  String
  isActive  Boolean  @default(true)
  viewCount Int      @default(0)
  images    String[] // Array of image URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User      @relation(fields: [authorId], references: [id])
  enquiries Enquiry[]
}

enum EnquiryStatus {
  pending
  responded
  rejected
  closed
  expired
}

model Enquiry {
  id         String        @id @default(cuid())
  propertyId String
  senderId   String
  receiverId String
  status     EnquiryStatus @default(pending)
  createdAt  DateTime      @default(now())
  closedAt   DateTime?

  property        Property         @relation(fields: [propertyId], references: [id])
  sender          User             @relation("SentEnquiries", fields: [senderId], references: [id])
  receiver        User             @relation("ReceivedEnquiries", fields: [receiverId], references: [id])
  enquiryMessages EnquiryMessage[]
}

model EnquiryMessage {
  id        String   @id @default(cuid())
  enquiryId String
  senderId  String
  message   String
  createdAt DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id])
  sender  User    @relation(fields: [senderId], references: [id])
}

enum PlanType {
  free
  basic
  premium
}

model Subscription {
  id        String   @id @default(cuid())
  dealerId  String
  planType  PlanType @default(free)
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
